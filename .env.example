# Postgres (Neon) — string de conexão usada pelo Drizzle (db:generate/db:migrate e pela API)
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Cal.com — link de agendamento exibido após o envio do diagnóstico (fallback: WhatsApp)
# NEXT_PUBLIC_CAL_URL=https://cal.com/seu-usuario/30min

# Resend — notificação por e-mail ao receber um novo diagnóstico (opcional)
# RESEND_API_KEY=
# DIAGNOSTIC_NOTIFY_TO=
# DIAGNOSTIC_NOTIFY_FROM=

# GaspLab Operacao — Supabase (projeto separado para o ambiente operacional)
# NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# URL publica usada nos redirects de autenticacao
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Pesquisa assistida no Google Places (somente consulta; respostas nao sao persistidas)
# GOOGLE_PLACES_API_KEY=

# WhatsApp Business Platform / Cloud API (opcional no piloto operacional)
# META_WHATSAPP_ACCESS_TOKEN=
# META_WHATSAPP_PHONE_NUMBER_ID=
# META_WHATSAPP_VERIFY_TOKEN=
# META_APP_SECRET=
# WHATSAPP_GRAPH_API_VERSION=v23.0

# Gaspar — OpenAI Responses API (opcional; a interface informa quando indisponivel)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-mini
